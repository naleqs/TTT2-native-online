# Writes OUTPUT: a logging stub for every kernel/XAM import declared in SHARED_HEADER
# (XenonRecomp's ppc_recomp_shared.h) that no runtime source implements with TT2_IMPORT().

file(READ "${SHARED_HEADER}" header)
string(REGEX MATCHALL "PPC_EXTERN_FUNC\\(__imp__[A-Za-z0-9_]+\\)" declarations "${header}")

set(imports)
foreach(d IN LISTS declarations)
    string(REGEX REPLACE "PPC_EXTERN_FUNC\\(__imp__([A-Za-z0-9_]+)\\)" "\\1" name "${d}")
    list(APPEND imports ${name})
endforeach()
list(REMOVE_DUPLICATES imports)

file(READ "${SOURCES_FILE}" sources)
set(implemented)
foreach(src IN LISTS sources)
    file(READ "${src}" content)
    string(REGEX MATCHALL "TT2_IMPORT\\([A-Za-z0-9_]+\\)" found "${content}")
    foreach(f IN LISTS found)
        string(REGEX REPLACE "TT2_IMPORT\\(([A-Za-z0-9_]+)\\)" "\\1" name "${f}")
        list(APPEND implemented ${name})
    endforeach()
endforeach()

set(out "// Generated by cmake/gen_import_stubs.cmake. Do not edit.\n#include \"guest.h\"\n\n")
string(APPEND out "namespace tt2 { void stub_called(const char* name); }\n\n")
set(count 0)
foreach(name IN LISTS imports)
    list(FIND implemented ${name} index)
    if(index EQUAL -1)
        string(APPEND out "TT2_IMPORT(${name}) { tt2::stub_called(\"${name}\"); ctx.r3.u64 = 0; }\n")
        math(EXPR count "${count} + 1")
    endif()
endforeach()

string(APPEND out "
#include <mutex>
#include <set>
#include <string>
namespace tt2
{
    void stub_called(const char* name)
    {
        static std::mutex m;
        static std::set<std::string> seen;
        std::lock_guard lock(m);
        if (seen.insert(name).second)
            log(\"import not implemented yet: %s\", name);
    }
}
")

list(LENGTH imports total)
message(STATUS "imports: ${total}, stubbed: ${count}")
file(WRITE "${OUTPUT}" "${out}")
