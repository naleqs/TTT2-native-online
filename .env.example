# TTT2 Native Online - optional settings.
# Copy this file to .env (same folder as Setup.bat) and uncomment what you need.
# .env is ignored by git; never commit it. Real environment variables override it.

# ---------------------------------------------------------------- setup

# Disc image (.iso) or extracted disc folder. Default: the single image in .\iso, else a file picker.
# TT2_IMAGE=D:\Games\Tekken Tag Tournament 2 (USA, Europe).iso

# Parallel compile jobs (default: number of CPU threads).
# TT2_JOBS=8

# Use clang, cmake, ninja and git from PATH instead of downloading the portable toolchain
# into native\toolchain (for developers who already have them).
# TT2_USE_SYSTEM_TOOLS=1

# ---------------------------------------------------------------- player

# TT2_PLAYER_NAME=Player
# Lobby room: everyone in the same room sees each other. Use a private word to play with friends only.
# TT2_LOBBY_ROOM=public

# ---------------------------------------------------------------- netplay

# UDP port for matches (direct connect: forward this port, or use a VPN such as Tailscale).
# The launcher also uses the next port (TT2_NETPLAY_PORT + 1) on 127.0.0.1 for lobby matches.
# TT2_NETPLAY_PORT=7000

# Input delay in frames, or auto (1 frame up to ~100 ms ping, more on worse connections).
# TT2_INPUT_DELAY=auto

# WebTorrent trackers used to find lobby peers (comma separated, wss://).
# They only pass connection offers between players; game traffic is peer to peer.
# TT2_TRACKERS=wss://tracker.openwebtorrent.com,wss://tracker.webtorrent.dev

# STUN/TURN servers for NAT traversal (comma separated). A TURN server helps players behind
# strict NATs; it relays traffic, so only use one you trust or run yourself.
# TT2_ICE_SERVERS=stun:stun.l.google.com:19302,turn:user:password@turn.example.com:3478

# ---------------------------------------------------------------- debugging

# Log every kernel/XAM call the game makes to native\logs\tt2.log (slow).
# TT2_TRACE=1
