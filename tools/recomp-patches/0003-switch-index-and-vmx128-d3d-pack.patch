diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -143,6 +143,63 @@
     uint8_t ov;
     uint8_t ca;
 };
+
+// VMX128 half floats (vpkd3d128 / vupkd3d128).
+inline float ppc_half_to_float(uint16_t h) noexcept
+{
+    const uint32_t sign = uint32_t(h & 0x8000) << 16;
+    uint32_t exponent = (h >> 10) & 0x1F, mantissa = h & 0x3FF, bits;
+    if (exponent == 0)
+    {
+        if (mantissa == 0)
+        {
+            bits = sign;
+        }
+        else
+        {
+            exponent = 113;
+            while (!(mantissa & 0x400))
+            {
+                mantissa <<= 1;
+                exponent--;
+            }
+            bits = sign | (exponent << 23) | ((mantissa & 0x3FF) << 13);
+        }
+    }
+    else if (exponent == 31)
+    {
+        bits = sign | 0x7F800000 | (mantissa << 13);
+    }
+    else
+    {
+        bits = sign | ((exponent + 112) << 23) | (mantissa << 13);
+    }
+    float f;
+    memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+// Same conversion as the float16_4 pack: truncating, NaN and |x| > 65504 become 0x7FFF.
+inline uint16_t ppc_float_to_half(uint32_t bits) noexcept
+{
+    const uint32_t magnitude = bits & 0x7FFFFFFF;
+    float f;
+    memcpy(&f, &magnitude, sizeof(f));
+    uint16_t h;
+    if (f != f || f > 65504.0f)
+    {
+        h = 0x7FFF;
+    }
+    else
+    {
+        const uint32_t exponent = magnitude >> 23, mantissa = (magnitude & 0x7FE000) >> 13;
+        if (exponent > 0x70)
+            h = uint16_t(((exponent - 0x70) << 10) + mantissa);
+        else
+            h = 0x71 - exponent > 31 ? 0 : uint16_t((0x400 + mantissa) >> (0x71 - exponent));
+    }
+    return uint16_t(h | ((bits & 0x80000000) >> 16));
+}
 
